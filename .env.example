# Copia este archivo a .env y ajusta los valores si es necesario.
# El .env real NUNCA se versiona (.gitignore lo excluye) — ver Artículo IX del spec.

# --- Base de datos (motor vacío; el esquema lo crean las migraciones del repo api) ---
POSTGRES_PASSWORD=library

# --- API (Laravel) ---
# Valores de EJEMPLO solo para desarrollo local. En un entorno real: valores distintos y secretos.
JWT_SECRET=dev-only-jwt-secret-change-me-3145555
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# APP_KEY vacía por defecto; genera una con:
#   docker compose exec api php artisan key:generate --show
# y pégala aquí si tu backend la exige.
APP_KEY=

# --- Puertos del host ---
# Defaults del proyecto: db 5433, api 8000, app 5173, page 8081.
# Si otro proyecto local ya usa uno de estos puertos, cámbialos aquí.
DB_HOST_PORT=5433
API_PORT=8000
APP_PORT=5173
PAGE_PORT=8081
# Puerto que expone el contenedor de la app React (según su Dockerfile; 80 si es nginx)
APP_CONTAINER_PORT=80
